{
  "openapi": "3.1.0",
  "info": {
    "title": "CK Sushi Backend — Staging",
    "version": "2026.11.22.staging.11",
    "description": "CK Sushi staging v11: painel de operações com navegação horizontal, tarefas de restaurante, catálogo real, categorias e filtros. Cloudflare Access necessário para escrita; pedidos e pagamentos bloqueados. Banco D1 v6 protegido por 18 gatilhos."
  },
  "servers": [
    {
      "url": "https://ck-sushi-backend-staging.ceoaran-dev.workers.dev"
    }
  ],
  "tags": [
    {
      "name": "Public"
    },
    {
      "name": "Checkout Preview"
    },
    {
      "name": "Admin"
    },
    {
      "name": "Disabled"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Public"
        ],
        "description": "Health and environment, without secrets",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "tags": [
          "Public"
        ],
        "description": "Read-only product catalog from D1",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/store/config": {
      "get": {
        "tags": [
          "Public"
        ],
        "description": "Read-only capabilities; orders/payments are false",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkout/quote": {
      "post": {
        "tags": [
          "Checkout Preview"
        ],
        "description": "Server prices cart, never creates order or charge",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido"
          },
          "403": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "JSON acima do limite de 8 KiB"
          },
          "415": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "items",
                  "fulfillment"
                ],
                "properties": {
                  "fulfillment": {
                    "enum": [
                      "delivery",
                      "pickup"
                    ]
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "product_id",
                        "quantity"
                      ],
                      "properties": {
                        "product_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{3,90}$"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/admin/session": {
      "get": {
        "tags": [
          "Admin"
        ],
        "description": "Authenticated role and CSRF context",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ]
      }
    },
    "/api/admin/products": {
      "get": {
        "tags": [
          "Admin"
        ],
        "description": "Product list (authenticated)",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ]
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "description": "Create product (authenticated, audited)",
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ]
      }
    },
    "/api/admin/products/{id}": {
      "patch": {
        "tags": [
          "Admin"
        ],
        "description": "Optimistic update (authenticated, audited)",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/admin/audit": {
      "get": {
        "tags": [
          "Admin"
        ],
        "description": "Owner-only audit records",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ]
      }
    },
    "/api/admin/summary": {
      "get": {
        "tags": [
          "Admin"
        ],
        "description": "Product and environment settings",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ]
      }
    },
    "/api/orders": {
      "post": {
        "tags": [
          "Disabled"
        ],
        "description": "Orders disabled until security/legal/payment homologation",
        "responses": {
          "503": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/payments": {
      "post": {
        "tags": [
          "Disabled"
        ],
        "description": "Payments disabled until merchant-owned credentials and tests",
        "responses": {
          "503": {
            "description": "Blocked by design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "Public"
        ],
        "description": "Sinal de saúde de homologação: requer versão 6, exatamente 18 triggers nomeados, pelo menos um produto público, 9 tabelas comerciais vazias e flags de pedido/pagamento/dados/rastreio desativadas.",
        "responses": {
          "200": {
            "description": "Homologação pronta, transações reais bloqueadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "status": {
                      "const": "ready"
                    },
                    "environment": {
                      "const": "staging"
                    },
                    "commerceEnabled": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Homologação indisponível ou proteções ausentes"
          }
        }
      }
    },
    "/api/webhooks/mercadopago/test": {
      "post": {
        "tags": [
          "Public"
        ],
        "summary": "Mercado Pago Orders test-only signed webhook",
        "description": "Requires MP_TEST_WEBHOOK_SECRET and MP_TEST_APPLICATION_ID, verified HMAC and test-mode notification. Stores only an expiring event fingerprint; never creates/updates real payments or orders. Returns 503 while credentials are absent.",
        "responses": {
          "200": {
            "description": "Valid test notification deduplicated; no payment processed"
          },
          "400": {
            "description": "Invalid event"
          },
          "401": {
            "description": "Invalid signature"
          },
          "403": {
            "description": "Wrong application/mode"
          },
          "429": {
            "description": "Rate-limited"
          },
          "503": {
            "description": "Secret not configured"
          }
        }
      }
    },
    "/api/admin/integrations/mercadopago": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Integration readiness, no secret values",
        "security": [
          {
            "cloudflareAccess": []
          }
        ],
        "responses": {
          "200": {
            "description": "Only Boolean configuration flags, excludes credential values"
          },
          "403": {
            "description": "Not authorized"
          },
          "503": {
            "description": "Cloudflare Access not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cloudflareAccess": {
        "type": "apiKey",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "description": "Cloudflare Access signed JWT, validated by Worker, plus authorized email"
      }
    }
  }
}
